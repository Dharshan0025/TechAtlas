# TechAtlas Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: API Keys and Credentials
# ============================================

# Google Gemini API Key (REQUIRED)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Credentials Path (REQUIRED)
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-key.json

# ============================================
# Server Configuration
# ============================================

# Server Port
PORT=5000

# Debug Mode (True/False)
DEBUG=False

# Host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# ============================================
# AI Model Configuration
# ============================================

# Gemini Model for text generation
# Options: models/gemini-1.5-flash (15 RPM free), models/gemini-1.5-pro (2 RPM free)
GEMINI_MODEL=models/gemini-1.5-flash

# Gemini Model for embeddings
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Rate limit delay (seconds between API calls to avoid quota errors)
RATE_LIMIT_DELAY=4.0

# ============================================
# Feature Flags
# ============================================

# Enable Analytics Features
ENABLE_ANALYTICS=True

# Enable Notification System
ENABLE_NOTIFICATIONS=False

# Enable Caching Layer
ENABLE_CACHING=False

# ============================================
# Application Limits
# ============================================

# Maximum decisions per page
MAX_DECISIONS_PER_PAGE=50

# Maximum search results
MAX_SEARCH_RESULTS=100

# Maximum upload size (MB)
MAX_UPLOAD_SIZE_MB=10

# ============================================
# Timeouts (seconds)
# ============================================

# Request timeout
REQUEST_TIMEOUT_SECONDS=30

# AI API timeout
AI_TIMEOUT_SECONDS=60

# ============================================
# Logging Configuration
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE=logs/techatlas_backend.log

# ============================================
# Cache Configuration
# ============================================

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# Maximum cache size
CACHE_MAX_SIZE=1000

# ============================================
# Risk Assessment Configuration
# ============================================

# High risk threshold (0-10)
HIGH_RISK_THRESHOLD=7

# Aging decision threshold (days)
AGING_DECISION_DAYS=60

# ============================================
# Notification Configuration
# ============================================

# Days before due date to send reminder
REMINDER_DAYS_BEFORE_DUE=7

# Notification email sender
NOTIFICATION_EMAIL_FROM=noreply@techatlas.com

# ============================================
# CORS Configuration
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Database Configuration
# ============================================

# Vector store path
VECTOR_STORE_PATH=./data/vector_store

# FAISS index dimension
EMBEDDING_DIMENSION=768
